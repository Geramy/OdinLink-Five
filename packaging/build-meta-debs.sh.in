#!/bin/bash
# Build self-contained OdinLink TB5 .deb packages
# Generated by CMake - do not edit directly.
#
# Usage: bash build-meta-debs.sh <build_dir>
#
# Creates 4 self-contained .debs, each containing the actual binaries,
# libraries, configs, and driver sources for its tier:
#   odl-tb5-minimal - driver + lib + rccl (GPU cluster nodes)
#   odl-tb5-server  - driver + lib + cli + daemon + rccl (headless servers)
#   odl-tb5-full    - everything

set -euo pipefail

VERSION="@PROJECT_VERSION@"
BUILD_DIR="${1:-.}"
OUT_DIR="${BUILD_DIR}/meta-packages"
ARCH="$(dpkg --print-architecture)"

rm -rf "$OUT_DIR"
mkdir -p "$OUT_DIR"

# ---- Helper: install cmake components into a package staging dir ----
install_components() {
    local pkg_dir="$1"
    shift
    for comp in "$@"; do
        DESTDIR="$pkg_dir" cmake --install "$BUILD_DIR" \
            --component "$comp" --prefix /usr 2>&1 | sed 's/^/    /'
    done
}

# ---- Helper: generate merged postinst script ----
write_postinst() {
    local out="$1"
    local has_dkms="$2"
    local has_daemon="$3"
    local has_tray="$4"

    cat > "$out" <<'HEADER'
#!/bin/sh
set -e
HEADER

    if [ "$has_dkms" = "yes" ]; then
        cat >> "$out" <<'STOP_BEFORE_DKMS'
# Stop daemon and tray before module reload (they hold the module open)
for uid_dir in /run/user/*; do
    uid=$(basename "$uid_dir")
    if [ -S "${uid_dir}/bus" ]; then
        user=$(id -nu "$uid" 2>/dev/null) || continue
        su - "$user" -c \
            "DBUS_SESSION_BUS_ADDRESS=unix:path=${uid_dir}/bus \
             systemctl --user stop odl-tb5-daemon.service" 2>/dev/null || true
    fi
done
pkill -x odl_tb5_tray 2>/dev/null || true
pkill -x odl_tb5_daemon 2>/dev/null || true
pkill -x odl_tb5_cli 2>/dev/null || true
sleep 1
pkill -9 -x odl_tb5_tray 2>/dev/null || true
pkill -9 -x odl_tb5_daemon 2>/dev/null || true
pkill -9 -x odl_tb5_cli 2>/dev/null || true
for i in 1 2 3 4 5; do
    rmmod odl_tb5 2>/dev/null && break
    sleep 1
done

STOP_BEFORE_DKMS

        cat >> "$out" <<DKMS
# DKMS: add, build, install kernel module
if [ -x /usr/sbin/dkms ]; then
    dkms add -m "odl-tb5" -v "${VERSION}" || true
    dkms build -m "odl-tb5" -v "${VERSION}" || true
    dkms install -m "odl-tb5" -v "${VERSION}" || true
fi

DKMS

        cat >> "$out" <<'SECUREBOOT'
# Secure Boot: sign the kernel module if Secure Boot is active
ODL_MOK_DIR="/var/lib/odl-tb5/mok"
ODL_MOK_KEY="$ODL_MOK_DIR/MOK.priv"
ODL_MOK_DER="$ODL_MOK_DIR/MOK.der"

if command -v mokutil >/dev/null 2>&1 && mokutil --sb-state 2>/dev/null | grep -qi "enabled"; then
    echo "Secure Boot is enabled -- signing OdinLink TB5 kernel module..."

    # Generate a MOK key pair if one doesn't exist yet
    mkdir -p "$ODL_MOK_DIR"
    if [ ! -f "$ODL_MOK_KEY" ] || [ ! -f "$ODL_MOK_DER" ]; then
        openssl req -new -x509 -newkey rsa:2048 \
            -keyout "$ODL_MOK_KEY" -outform DER -out "$ODL_MOK_DER" \
            -nodes -days 36500 -subj "/CN=OdinLink TB5 Module Signing/" 2>/dev/null
        chmod 600 "$ODL_MOK_KEY"
    fi

    # Find and sign the installed module
    KVER="$(uname -r)"
    SIGN_FILE=""
    for p in \
        "/usr/src/linux-headers-${KVER}/scripts/sign-file" \
        "/usr/lib/linux-kbuild-*/scripts/sign-file" \
        "/usr/src/kernels/${KVER}/scripts/sign-file"; do
        # shellcheck disable=SC2086
        for f in $p; do
            [ -x "$f" ] && SIGN_FILE="$f" && break 2
        done
    done

    MODULE="/lib/modules/${KVER}/updates/dkms/odl_tb5.ko"
    # Also check for compressed variants
    [ ! -f "$MODULE" ] && MODULE="/lib/modules/${KVER}/updates/dkms/odl_tb5.ko.zst"
    [ ! -f "$MODULE" ] && MODULE="/lib/modules/${KVER}/updates/dkms/odl_tb5.ko.xz"

    if [ -n "$SIGN_FILE" ] && [ -f "$MODULE" ]; then
        "$SIGN_FILE" sha256 "$ODL_MOK_KEY" "$ODL_MOK_DER" "$MODULE"
        echo "Module signed successfully."
    else
        echo "WARNING: Could not sign module (sign-file or module not found)."
        echo "  sign-file: ${SIGN_FILE:-not found}"
        echo "  module:    ${MODULE}"
    fi

    # Check if our MOK is already enrolled
    if ! mokutil --test-key "$ODL_MOK_DER" 2>/dev/null | grep -qi "already enrolled"; then
        echo ""
        echo "============================================================"
        echo "  SECURE BOOT: You must enroll the OdinLink signing key."
        echo ""
        echo "  Run:  sudo mokutil --import $ODL_MOK_DER"
        echo ""
        echo "  You will set a one-time password, then reboot."
        echo "  The MOK manager will ask you to confirm enrollment."
        echo "============================================================"
        echo ""
    fi
fi

SECUREBOOT
    fi

    cat >> "$out" <<'COMMON'
# Reload udev rules
udevadm control --reload-rules 2>/dev/null || true
udevadm trigger 2>/dev/null || true

# Update shared library cache
ldconfig 2>/dev/null || true
COMMON

    if [ "$has_dkms" = "yes" ]; then
        cat >> "$out" <<'MODPROBE'

# Ensure module loads on every boot
echo "odl_tb5" > /etc/modules-load.d/odl_tb5.conf

# Load kernel module now
modprobe odl_tb5 2>/dev/null || true
MODPROBE
    fi

    if [ "$has_daemon" = "yes" ]; then
        cat >> "$out" <<'DAEMON'

# Kill any running old daemon before starting the new one
pkill -x odl_tb5_daemon 2>/dev/null || true
sleep 1
pkill -9 -x odl_tb5_daemon 2>/dev/null || true

# Reload systemd for daemon service
systemctl --global daemon-reload 2>/dev/null || true

# Enable linger so user services survive without a login session
if [ -n "$SUDO_USER" ]; then
    loginctl enable-linger "$SUDO_USER" 2>/dev/null || true
fi

# Restart daemon for the installing user
if [ -n "$SUDO_USER" ]; then
    DAEMON_UID=$(id -u "$SUDO_USER" 2>/dev/null) || true
    if [ -n "$DAEMON_UID" ] && [ -S "/run/user/${DAEMON_UID}/bus" ]; then
        su - "$SUDO_USER" -c \
            "DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/${DAEMON_UID}/bus \
             systemctl --user restart odl-tb5-daemon.service" 2>/dev/null || true
    fi
fi
DAEMON
    fi

    if [ "$has_tray" = "yes" ]; then
        cat >> "$out" <<'TRAY'

# Update icon cache and desktop database
gtk-update-icon-cache -f -t /usr/share/icons/hicolor 2>/dev/null || true
update-desktop-database /usr/share/applications 2>/dev/null || true

# Launch tray app for the installing user (if running a desktop session)
if [ -n "$SUDO_USER" ] && [ -n "$DISPLAY" ] || [ -n "$WAYLAND_DISPLAY" ]; then
    TRAY_USER="$SUDO_USER"
    TRAY_UID=$(id -u "$TRAY_USER" 2>/dev/null)
    if [ -n "$TRAY_UID" ] && [ -S "/run/user/${TRAY_UID}/bus" ]; then
        su - "$TRAY_USER" -c "DISPLAY=${DISPLAY:-:0} DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/${TRAY_UID}/bus nohup odl_tb5_tray >/dev/null 2>&1 &" || true
    fi
fi
TRAY
    fi

    chmod 755 "$out"
}

# ---- Helper: generate prerm script ----
write_prerm() {
    local out="$1"
    local has_daemon="$2"

    cat > "$out" <<'HEADER'
#!/bin/sh
set -e
HEADER

    cat >> "$out" <<'STOP_ALL'
# Stop daemon and tray for all logged-in users before module unload
for uid_dir in /run/user/*; do
    uid=$(basename "$uid_dir")
    if [ -S "${uid_dir}/bus" ]; then
        user=$(id -nu "$uid" 2>/dev/null) || continue
        su - "$user" -c \
            "DBUS_SESSION_BUS_ADDRESS=unix:path=${uid_dir}/bus \
             systemctl --user stop odl-tb5-daemon.service" 2>/dev/null || true
    fi
done
pkill -x odl_tb5_tray 2>/dev/null || true
pkill -x odl_tb5_daemon 2>/dev/null || true
pkill -x odl_tb5_cli 2>/dev/null || true
sleep 1
pkill -9 -x odl_tb5_tray 2>/dev/null || true
pkill -9 -x odl_tb5_daemon 2>/dev/null || true
pkill -9 -x odl_tb5_cli 2>/dev/null || true
STOP_ALL

    cat >> "$out" <<DKMS_REMOVE

# Unload kernel module — retry up to 5 times
for i in 1 2 3 4 5; do
    rmmod odl_tb5 2>/dev/null && break
    sleep 1
done

# Remove boot autoload config
rm -f /etc/modules-load.d/odl_tb5.conf

# Remove DKMS module
if [ -x /usr/sbin/dkms ]; then
    dkms remove -m "odl-tb5" -v "${VERSION}" --all 2>/dev/null || true
fi
DKMS_REMOVE
    chmod 755 "$out"
}

# ---- Helper: generate postrm script ----
write_postrm() {
    local out="$1"
    local has_dkms="$2"
    local has_daemon="$3"
    local has_tray="$4"

    cat > "$out" <<'HEADER'
#!/bin/sh
set -e
HEADER

    if [ "$has_daemon" = "yes" ]; then
        cat >> "$out" <<'DAEMON_CLEANUP'
# Stop any remaining daemon processes
pkill -x odl_tb5_daemon 2>/dev/null || true
systemctl --global daemon-reload 2>/dev/null || true
DAEMON_CLEANUP
    fi

    if [ "$has_dkms" = "yes" ]; then
        cat >> "$out" <<'DKMS_CLEANUP'
# Reload udev rules after our rules file is removed
udevadm control --reload-rules 2>/dev/null || true
udevadm trigger 2>/dev/null || true
DKMS_CLEANUP
    fi

    cat >> "$out" <<'COMMON'
# Clean up shared library cache
ldconfig 2>/dev/null || true
COMMON

    if [ "$has_tray" = "yes" ]; then
        cat >> "$out" <<'TRAY_CLEANUP'
# Update desktop database and icon cache
update-desktop-database /usr/share/applications 2>/dev/null || true
gtk-update-icon-cache -f -t /usr/share/icons/hicolor 2>/dev/null || true
TRAY_CLEANUP
    fi

    chmod 755 "$out"
}

# ---- Main: build a self-contained .deb ----
build_deb() {
    local pkg_name="$1"
    local depends="$2"
    local description="$3"
    local has_dkms="$4"
    local has_daemon="$5"
    local has_tray="$6"
    shift 6
    local components=("$@")

    local pkg_dir="${OUT_DIR}/${pkg_name}_${VERSION}_${ARCH}"
    mkdir -p "${pkg_dir}/DEBIAN"

    # Install all component files into the staging directory
    echo "  Installing components: ${components[*]}"
    install_components "$pkg_dir" "${components[@]}"

    # Write control file
    local size_kb
    size_kb=$(du -sk "$pkg_dir" | cut -f1)

    cat > "${pkg_dir}/DEBIAN/control" <<EOF
Package: ${pkg_name}
Version: ${VERSION}
Architecture: ${ARCH}
Maintainer: OdinLink Project <odinlink@example.com>
Depends: ${depends}
Installed-Size: ${size_kb}
Section: misc
Priority: optional
Homepage: https://github.com/OdinLink/OdinLink-Five
Description: ${description}
EOF

    # Generate maintainer scripts
    write_postinst "${pkg_dir}/DEBIAN/postinst" "$has_dkms" "$has_daemon" "$has_tray"
    write_prerm    "${pkg_dir}/DEBIAN/prerm" "$has_daemon"
    write_postrm   "${pkg_dir}/DEBIAN/postrm" "$has_dkms" "$has_daemon" "$has_tray"

    # Build the .deb
    dpkg-deb --build --root-owner-group "${pkg_dir}" \
        "${OUT_DIR}/${pkg_name}_${VERSION}_${ARCH}.deb"

    rm -rf "${pkg_dir}"
    echo "  -> ${pkg_name}_${VERSION}_${ARCH}.deb"
}

echo "Building OdinLink TB5 packages (v${VERSION}, ${ARCH})..."
echo ""

# 1. Minimal: driver + lib + rccl + nccl (bare minimum for GPU cluster nodes)
echo "[1/3] odl-tb5-minimal"
build_deb "odl-tb5-minimal" \
    "dkms, gcc-14 | gcc-15 | gcc, libc6, mokutil, openssl" \
    "OdinLink Thunderbolt 5 - Minimal (GPU cluster node)
 Installs the kernel driver (DKMS), userspace library, and RCCL + NCCL
 plugins. Bare minimum for a GPU cluster node to participate in GPU
 collective operations over Thunderbolt 5." \
    "yes" "no" "no" \
    dkms library rccl nccl

# 2. Server: headless with full management (no tray, no dev headers)
echo "[2/3] odl-tb5-server"
build_deb "odl-tb5-server" \
    "dkms, gcc-14 | gcc-15 | gcc, libc6, mokutil, openssl, libglib2.0-0 (>= 2.56)" \
    "OdinLink Thunderbolt 5 - Server (headless)
 Installs everything except the GUI tray application. Includes the
 kernel driver, library, CLI tool, background daemon, and both
 RCCL (AMD) + NCCL (NVIDIA) plugins." \
    "yes" "yes" "no" \
    dkms library cli daemon rccl nccl

# 3. Full: everything
echo "[3/3] odl-tb5-full"
build_deb "odl-tb5-full" \
    "dkms, gcc-14 | gcc-15 | gcc, libc6, mokutil, openssl, libglib2.0-0 (>= 2.56), libgtk-3-0 (>= 3.22), libayatana-appindicator3-1" \
    "OdinLink Thunderbolt 5 - Full (all components)
 Installs every OdinLink TB5 component: kernel driver, library,
 development headers, CLI tool, daemon, tray app, and both
 RCCL (AMD) + NCCL (NVIDIA) plugins." \
    "yes" "yes" "yes" \
    dkms library library-dev cli daemon tray rccl nccl

echo ""
echo "All packages built in: ${OUT_DIR}/"
ls -lh "${OUT_DIR}"/*.deb
